    <!-- Primary SEO Page Title & Meta Description -->
    <title>BEST FOODS | Import-Export Agroalimentaire, Épices & Denrées Dakar Sénégal</title>
    <meta 
      name="description" 
      content="BEST FOODS Dakar (Sénégal) : Leader du négoce et import-export de denrées agroalimentaires, épices pures, poivre noir, piment sec, clou de girofle, sucre & café. Cotation rapide CIF / FOB." 
    />
    <meta 
      name="keywords" 
      content="BEST FOODS, import export Dakar, négoce agroalimentaire Sénégal, épices brutes Dakar, poivre noir export Sénégal, piment sec Dakar, clous de girofle gros, sucre ICUMSA 45 Sénégal, légumineuses Afrique de l'Ouest, café robusta brut, port autonome de Dakar PAD, grossiste épices Dakar, négoce international denrées" 
    />
